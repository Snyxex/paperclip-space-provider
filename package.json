{
  "name": "paperclip-space-provider",
  "version": "0.1.0-alpha.1",
  "description": "Experimental community Paperclip sandbox provider for self-hosted Perplexity SPACE Firecracker VMs",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "keywords": [
    "paperclip",
    "space",
    "firecracker",
    "sandbox",
    "self-hosted"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1012.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "typecheck": "node scripts/build.mjs --verify-only",
    "pack:check": "npm pack --dry-run",
    "check:package": "node scripts/package-gate.mjs",
    "check:public": "node scripts/check-public.mjs",
    "test:space:integration": "node examples/native-sync-integration.mjs",
    "check:paperclip-host": "node scripts/paperclip-host-preflight.mjs"
  }
}
