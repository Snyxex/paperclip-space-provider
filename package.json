{
  "name": "@snyxex/paperclip-space-provider",
  "version": "0.1.0-alpha.1",
  "description": "Experimental community Paperclip sandbox provider for self-hosted Perplexity SPACE Firecracker VMs",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snyxex/paperclip-space-provider.git"
  },
  "homepage": "https://github.com/Snyxex/paperclip-space-provider",
  "keywords": [
    "paperclip",
    "space",
    "firecracker",
    "sandbox",
    "self-hosted"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1012.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "typecheck": "node scripts/build.mjs --verify-only",
    "pack:check": "npm pack --dry-run",
    "test:space:integration": "node examples/native-sync-integration.mjs"
  }
}
